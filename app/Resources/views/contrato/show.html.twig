{% extends 'base.html.twig' %}

{% block body %}
	<div class="container">
		<div class="row">
			<div class="col-xs-8">
				<h1>Contrato:
					{% if contrato %}
						{{ contrato.id }}
					{% endif %}
				</h1>
				<table class="table">
					<tbody>
					<tr>
						<th>Numero de Orden</th>
						<td>{{ contrato.noDeOrden }}</td>
					</tr>
					<tr>
						<th>Tipo de Contrato</th>
						<td>{{ contrato.tipoDeContrato |json_encode}}</td>
					</tr>
					<tr>
						<th>Valor inicial en MN</th>
						<td>{{ contrato.valorInicialMn |number_format}}</td>
					</tr>
					<tr>
						<th>Valor inicial en CUC</th>
						<td>{{ contrato.valorInicialCuc |number_format}}</td>
					</tr>
					<tr>
						<th>Suplemento</th>
						<td>{{ contrato.isSuplemento }}</td>
					</tr>
					<tr>
						<th>Acta de Firmado</th>
						<td>{{ contrato.actaDeFirmado }}</td>
					</tr>
					<tr>
						<th>Fecha de Otorgamiento</th>
						<td>{{ contrato.fechaDeOtorgamiento |date('Y-m-d')}}</td>
					</tr>
					<tr>
						<th>Fecha de Vencimiento</th>
						<td>{{ contrato.fechaDeVencimiento |date('Y-m-d')}}</td>
					</tr>
					<tr>
						<th>Telefono</th>
						<td>{{ contrato.telefono }}</td>
					</tr>
					<tr>
						<th>Correo</th>
						<td>{{ contrato.correo }}</td>
					</tr>
					<tr>
						<th>Cliente</th>
						<td>{{ contrato.isCliente }}</td>
					</tr>
					<tr>
						<th>Proveedor</th>
						<td>{{ contrato.isProveedor }}</td>
					</tr>
					<tr>
						<th>Ministerio</th>
						<td>{{ contrato.ministerio |json_encode}}</td>
					</tr>
					</tbody>
				</table>
			</div>
			<div class="col-xs-2">
				<h3>Empresa:</h3>
				<ul class="list-group">
					<li class="list-group-item">
						<a href="{{ path('mostrar_empresa',{
							'id' : contrato.empresa.id
						}) }}">
						{{ contrato.empresa.nombre }}
						</a>
					</li>
				</ul>
			</div>
			<div class="col-xs-2">
				<h3>Facturas Asociadas:</h3>
				<ul class="list-group">
					{% for factura in contrato.facturas %}
					<li class="list-group-item">

							<a href="{{ path('show_factura',{
								'id' : factura.id
							}) }}">
								{{ factura.id }}
							</a>

					</li>
					{% endfor %}
				</ul>
			</div>
		</div>
	</div>
{% endblock %}
