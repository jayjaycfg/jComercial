{% extends 'base.html.twig' %}

{% block body %}
	<div class="container">
		<div class="row">

			<div class="col-xs-12">
				<div class="pull-right" style="margin-bottom: 10px; margin-top: 20px;">
					<a href="{{ path('crear_contrato') }}" class="btn btn-primary pull-right">Insertar <span class="fa fa-plus-circle"></span></a>
				</div>

				<h1>Contratos</h1>

				<table class="table table-striped js-table">
					<tr>
						<th>ID</th>
						<th>Numero de Orden</th>
						{#<th>Tipo de Contrato</th>#}
						{#<th>Valor inicial en MN</th>#}
						{#<th>Valor inicial en CUC</th>#}
						{#<th>Suplemento</th>#}
						{#<th>Acta de Firmado</th>#}
						<th>Fecha de Otorgamiento</th>
						<th>Fecha de Vencimiento</th>
						<th>Telefono</th>
						<th>Correo</th>
						{#<th>Cliente</th>#}
						{#<th>Proveedor</th>#}
						{#<th>Ministerio</th>#}
						{#<th>Empresas</th>#}
						<th>&nbsp;</th>
						<th>&nbsp;</th>
					</tr>
					{% for contrato in contratos %}
						<tr>
							<td>
								<a href="{{ path('mostrar_contrato',{
									'id' : contrato.id
								}) }}">
									{{ contrato.id }}
								</a>
							</td>
							<td>{{ contrato.noDeOrden}}</td>
							{#<td>{{ contrato.tipoDeContrato |json_encode}}</td>#}
							{#<td>{{ contrato.valorInicialMn |number_format}}</td>#}
							{#<td>{{ contrato.valorInicialCuc |number_format}}</td>#}
							{#<td>{{ contrato.isSuplemento}}</td>#}
							{#<td>{{ contrato.actaDeFirmado}}</td>#}
							<td>{{ contrato.fechaDeOtorgamiento |date('Y-m-d')}}</td>
							<td>{{ contrato.fechaDeVencimiento |date('Y-m-d')}}</td>
							<td>{{ contrato.telefono}}</td>
							<td>{{ contrato.correo}}</td>
							{#<td>{{ contrato.isCliente}}</td>#}
							{#<td>{{ contrato.isProveedor}}</td>#}
							{#<td>{{ contrato.ministerio |json_encode}}</td>#}
							{#{% for empresa in contrato.empresas %}#}
							{#<td>{{ empresa.nombre}}</td>#}
							{#{% endfor %}#}

							<td>
								<a href="{{ path('modificar_contrato',{
									'id' : contrato.id
								}) }}" class="pull-right btn-xs btn-link">
									<span class="fa fa-pencil"></span>
								</a>
							</td>
							<td>
								<a href="#" class="pull-right btn-xs btn-link">
									<span class="fa fa-save"></span>

								</a>
							</td>
						</tr>
					{% endfor %}
				</table>
			</div>
		</div>
	</div>
{% endblock %}


