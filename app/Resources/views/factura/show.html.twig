{% extends 'base.html.twig' %}

{% block body %}
	<div class="container">
		<div class="row">
			<div class="col-xs-8">
				<h1>Factura:
				{% if factura %}
					{{ factura.id }}
				{% endif %}
				</h1>
				<table class="table">
					<tbody>
					<tr>
						<th>Programa</th>
						<td>{{ factura.programa }}</td>
					</tr>
					<tr>
						<th>Descripcion del gasto</th>
						<td>{{ factura.descripcionDelGasto }}</td>
					</tr>
					<tr>
						<th>Cantidad</th>
						<td>{{ factura.cantidad }}</td>
					</tr>
					<tr>
						<th>Precio</th>
						<td>{{ factura.precio }}</td>
					</tr>
					<tr>
						<th>Participante</th>
						<td>{{ factura.participante }}</td>
					</tr>
					<tr>
						<th>Fecha</th>
						<td>{{ factura.fechaAt |date('Y-m-d') }}</td>
					</tr>
					{% if factura.isCancelada == 'true' %}
					<tr>
						<th>Cancelada</th>
						<td>Factura cancelada</td>
					</tr>
					<tr>
						<th>Explicacion</th>
						<td>{{ factura.explicacionPorCancelada }}</td>
					</tr>
					{% endif %}
					<tr>
						<th>Usuario</th>
						<td>{{ factura.usuario }}</td>
					</tr>
					<tr>
						<th>Contrato</th>
						<td>
							<a href="">
							{{ factura.contrato.noDeOrden}}
							</a>
						</td>
					</tr>
					<tr>
						<th>Empresa</th>
						<td>
							<a href="">
							{{ factura.empresa.nombre }}
							</a>
						</td>
					</tr>
					</tbody>
				</table>
			</div>
			<div class="col-xs-2">
				<h3>Empresa:</h3>
				<ul class="list-group">
					<li class="list-group-item">
						<a href="{{ path('mostrar_empresa',{
							'id' : factura.empresa.id
						}) }}">
							{{ factura.empresa.nombre }}
						</a>
					</li>
				</ul>
			</div>
			<div class="col-xs-2">
				<h3>Contrato:</h3>
				<ul class="list-group">
					<li class="list-group-item">Contrato</li>
					<li class="list-group-item">
						<a href="{{ path('mostrar_contrato',{
							'id' : factura.contrato.id
						}) }}">
							{{ factura.contrato.noDeOrden }}
						</a>
					</li>
				</ul>
			</div>
		</div>
	</div>
{% endblock %}
