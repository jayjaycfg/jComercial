{% extends 'base.html.twig' %}

{% block body %}
	<div class="container">
		<div class="row">
			<div class="col-xs-8">
				<h1>Factura:
				{% if factura %}
					{{ factura.id }}
				{% endif %}
				</h1>
				<table class="table">
					<tbody>
					<tr>
						<th>Programa</th>
						<td>{{ factura.programa }}</td>
					</tr>
					<tr>
						<th>Descripcion del gasto</th>
						<td>{{ factura.descripcionDelGasto }}</td>
					</tr>
					<tr>
						<th>Cantidad</th>
						<td>{{ factura.cantidad }}</td>
					</tr>
					<tr>
						<th>Precio</th>
						<td>{{ factura.precio }}</td>
					</tr>
					<tr>
						<th>Participante</th>
						<td>{{ factura.participante }}</td>
					</tr>
					<tr>
						<th>Fecha</th>
						<td>{{ factura.fechaAt |date('Y-m-d') }}</td>
					</tr>
					{% if factura.isCancelada == 'true' %}
					<tr>
						<th>Cancelada</th>
						<td>Factura cancelada</td>
					</tr>
					<tr>
						<th>Explicacion</th>
						<td>{{ factura.explicacionPorCancelada }}</td>
					</tr>
					{% endif %}
					<tr>
						<th>Usuario</th>
						<td>{{ factura.usuario }}</td>
					</tr>
					<tr>
						<th>Contrato</th>
						<td>{{ factura.contrato }}</td>
					</tr>
					<tr>
						<th>Empresa</th>
						<td>{{ factura.empresa }}</td>
					</tr>
					</tbody>
				</table>
			</div>
			<div class="col-xs-4">
				<h3>Empresa:</h3>
			</div>
		</div>
	</div>
{% endblock %}
