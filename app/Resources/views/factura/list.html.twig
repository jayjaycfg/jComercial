{% extends 'base.html.twig' %}

{% block body %}
	<div class="container">
		<div class="row">

			<div class="col-xs-12">
				<div class="pull-right" style="margin-bottom: 10px; margin-top: 20px;">
					<a href="{{ path('new_factura') }}" class="btn btn-primary pull-right">Insertar <span class="fa fa-plus-circle"></span></a>
				</div>

				<h1>Facturas</h1>

				<table class="table table-striped js-table">
					<tr>
						<th>ID</th>
						<th>Usuario</th>
						<th>Contrato</th>
						<th>Empresa</th>
						<th>Programa</th>
						<th>Descripcion</th>
						<th>Cantidad</th>
						<th>Precio</th>
						<th>Participante</th>
						<th>Fecha</th>
						<th>Cancelada</th>
						<th>Explicacion</th>
						<th>&nbsp;</th>
						<th>&nbsp;</th>
					</tr>
					{% for factura in facturas %}
						<tr>
							<td>
								<a href="{{ path('show_factura',{
									'id' : factura.id
								}) }}">
									{{ factura.id }}
								</a>
							</td>
							<td>{{ factura.usuario}}</td>
							<td>{{ factura.contrato}}</td>
							<td>{{ factura.empresa }}</td>
							<td>{{ factura.programa |json_encode}}</td>
							<td>{{ factura.descripcionDelGasto}}</td>
							<td>{{ factura.cantidad }}</td>
							<td>{{ factura.precio}}</td>
							<td>{{ factura.participante}}</td>
							<td>{{ factura.fechaAt |date('Y-m-d') }}</td>
							<td>{{ factura.isCancelada}}</td>
							<td>{{ factura.explicacionPorCancelada}}</td>
							<td>
								<a href="{{ path('edit_factura',{
									'id' : factura.id
								}) }}" class="pull-right btn-xs btn-link">
									<span class="fa fa-pencil"></span>
								</a>
							</td>
							<td>
								<a href="#" class="pull-right btn-xs btn-link js-cancelar-factura"
								data-url = "{{ path('cancelada',{
									'id' : factura.id
								}) }}"
								>
									<span class="fa fa-close"></span>

								</a>
							</td>
						</tr>
					{% endfor %}
				</table>
			</div>
		</div>
	</div>
{% endblock %}


{% block javascripts %}
	{{ parent() }}
	<script>
		$(document).ready(function () {
			var $table = $('.js-table');
			$table.find('.js-cancelar-factura').on('click',function (e) {
				e.preventDefault();
				var $row = $(this).closest('tr');

				$.ajax({
					url: $(this).data('url')
				}).done(function () {
					$row.fadeOut();
                });
            });
        });
	</script>
{% endblock %}